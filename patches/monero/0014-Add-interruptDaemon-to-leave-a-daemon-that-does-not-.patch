+}
+
 bool WalletImpl::store(const std::string &path)
 {
     clearStatus();
diff --git a/src/wallet/api/wallet.h b/src/wallet/api/wallet.h
index bc5a23c..eeda1fa 100644
--- a/src/wallet/api/wallet.h
+++ b/src/wallet/api/wallet.h
@@ -102,6 +102,7 @@ public:
     std::string publicMultisigSignerKey() const override;
     std::string path() const override;
     void stop() override;
+    bool interruptDaemon() override;
     bool store(const std::string &path) override;
     bool storeBlocking(const std::string &path) override;
     std::string filename() const override;
diff --git a/src/wallet/api/wallet2_api.h b/src/wallet/api/wallet2_api.h
index 650f3f9..307288e 100644
--- a/src/wallet/api/wallet2_api.h
+++ b/src/wallet/api/wallet2_api.h
@@ -577,6 +577,15 @@ struct Wallet
      */
     virtual void stop() = 0;
 
+    /*!
+     * \brief interruptDaemon - makes the daemon request in flight fail and return, and every
+     *        later one fail at once, until init() gives the wallet a daemon again. It waits for
+     *        nothing, so it gets through while a request the daemon never answers holds the
+     *        locks init() and close() need. Callable from any thread, not during close().
+     * \return false when the wallet's connection cannot be interrupted
+     */
+    virtual bool interruptDaemon() = 0;
+
     /*!
      * \brief store - stores wallet to file.
      * \param path - main filename to store wallet to. additionally stores address file and keys file.
diff --git a/src/wallet/wallet2.cpp b/src/wallet/wallet2.cpp
index af28090..6a6aa9e 100644
--- a/src/wallet/wallet2.cpp
+++ b/src/wallet/wallet2.cpp
@@ -1397,6 +1397,7 @@ bool wallet2::set_daemon(std::string daemon_address, boost::optional<epee::net_u
 
   if(m_http_client->is_connected())
     m_http_client->disconnect();
+  m_http_client->resume(); // ends interrupt_daemon(), whether or not the daemon gets set
   CHECK_AND_ASSERT_MES2(m_proxy.empty() || proxy.empty() , "It is not possible to set global proxy (--proxy) and daemon specific proxy together.");
   if(m_proxy.empty())
     CHECK_AND_ASSERT_MES(set_proxy(proxy), false, "failed to set proxy address");
diff --git a/src/wallet/wallet2.h b/src/wallet/wallet2.h
index 9624745..8057cbb 100644
--- a/src/wallet/wallet2.h
+++ b/src/wallet/wallet2.h
@@ -1087,6 +1087,9 @@ private:
     void stop() { m_run.store(false, std::memory_order_relaxed); m_message_store.stop(); }
     // teardown-only: a permanent stop that also aborts an in-flight daemon request
     void shutdown() { m_stopped.store(true, std::memory_order_relaxed); stop(); m_http_client->shutdown(); }
+    // makes the daemon request in flight fail, and every later one, until set_daemon() is
+    // called again. Takes no lock, so it gets through to a request that holds them
+    bool interrupt_daemon() { return m_http_client->interrupt(); }
 
     i_wallet2_callback* callback() const { return m_callback; }
     void callback(i_wallet2_callback* callback) { m_callback = callback; }
