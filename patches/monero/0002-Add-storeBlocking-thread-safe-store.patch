+bool WalletImpl::storeBlocking(const std::string &path)
+{
+    // Hold the same mutex doRefresh() takes around wallet2::refresh(), so the
+    // cache serialization performed by store() can never run concurrently with a
+    // refresh that mutates the wallet (e.g. the m_blockchain hashchain deque).
+    // Callable from any thread EXCEPT the refresh thread's refreshed() callback,
+    // which already holds m_refreshMutex2 (boost::mutex is non-recursive).
+    boost::lock_guard<boost::mutex> guard(m_refreshMutex2);
+    return store(path);
+}
