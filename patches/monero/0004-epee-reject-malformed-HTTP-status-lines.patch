From 0d5a25e168de5785318a3f31a20a3cc677bf7d90 Mon Sep 17 00:00:00 2001
From: Samy <samy@ap4.sh>
Date: Sat, 3 Oct 2026 10:57:58 +0200
Subject: [PATCH 04/10] epee: reject malformed HTTP status lines

(cherry picked from commit 21963b72351ea6f8a74ebdbf91303eb5a4947294)

diff --git a/contrib/epee/include/net/http_client.h b/contrib/epee/include/net/http_client.h
index a73181666..0607ebd0c 100644
--- a/contrib/epee/include/net/http_client.h
+++ b/contrib/epee/include/net/http_client.h
@@ -395,6 +395,7 @@ namespace net_utils
 				else
                 {
                   LOG_PRINT_L3("Returning false because of wrong state machine. state: " << m_state);
+                  disconnect();
                   return false;
                 }
 			}
@@ -758,7 +759,8 @@ namespace net_utils
 				bool analize_cached_header_and_invoke_state()
 			{
 				m_response_info.clear();
-				analize_first_response_line();
+				if (!analize_first_response_line())
+					return false;
 				std::string fake_str; //gcc error workaround
 
 				bool res = parse_header(m_response_info.m_header_info, m_header_cache);
diff --git a/tests/unit_tests/http.cpp b/tests/unit_tests/http.cpp
index 86e0e55ae..42e6676b9 100644
--- a/tests/unit_tests/http.cpp
+++ b/tests/unit_tests/http.cpp
@@ -120,6 +120,12 @@ private:
 class test_http_client final : public http::http_simple_client_template<dummy_client>
 {
 public:
+  bool disconnect() override
+  {
+    disconnected = true;
+    return http::http_simple_client_template<dummy_client>::disconnect();
+  }
+
   bool on_header(const http::http_response_info& headers) override
   {
     ++headers_seen;
@@ -129,6 +135,7 @@ public:
 
   http::http_response_info last_headers;
   unsigned headers_seen = 0;
+  bool disconnected = false;
 };
 
 class capturing_http_handler final : public http::i_http_server_handler<epee::net_utils::connection_context_base>
@@ -1029,6 +1036,23 @@ TEST(HTTP, Client_Rejects_Malformed_Response_Header)
 
   EXPECT_FALSE(result);
   EXPECT_EQ(0u, client.headers_seen);
+  EXPECT_TRUE(client.disconnected);
+}
+
+TEST(HTTP, Client_Rejects_Missing_Response_Status)
+{
+  test_http_client client;
+  const bool result = client.test(
+    "X-Test: abc\r\n"
+    "Content-Length: 3\r\n"
+    "\r\n"
+    "abc",
+    std::chrono::milliseconds(1000)
+  );
+
+  EXPECT_FALSE(result);
+  EXPECT_EQ(0u, client.headers_seen);
+  EXPECT_TRUE(client.disconnected);
 }
 
 TEST(HTTP, Add_Field)
