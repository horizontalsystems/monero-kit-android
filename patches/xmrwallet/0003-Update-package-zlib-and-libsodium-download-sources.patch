From 4784a2ad9524b9696109c455833c2db2890a520a Mon Sep 17 00:00:00 2001
From: abdrasulov <abdrasulov@gmail.com>
Date: Wed, 4 Nov 2026 14:51:02 +0600
Subject: [PATCH] Update package, zlib and libsodium download sources

Debian bullseye packages now live on archive.debian.org, zlib releases
are no longer served from zlib.net's top level, libsodium no longer
carries a 1.0.18 tag, and its autogen.sh can no longer download
config.sub and config.guess from savannah. Fetch the packages from
archive.debian.org, zlib from its GitHub release page, check out
libsodium by its pinned commit, and keep the automake-installed config
scripts.
---
 external-libs/android32.Dockerfile     | 11 +++++++----
 external-libs/android64.Dockerfile     | 11 +++++++----
 external-libs/android64_x86.Dockerfile | 11 +++++++----
 3 files changed, 21 insertions(+), 12 deletions(-)

diff --git a/external-libs/android32.Dockerfile b/external-libs/android32.Dockerfile
index 8fae6af..c400194 100644
--- a/external-libs/android32.Dockerfile
+++ b/external-libs/android32.Dockerfile
@@ -1,6 +1,8 @@
 FROM debian:bullseye
 
-RUN set -x && apt-get update && apt-get install -y unzip automake build-essential curl file pkg-config git python3 python-is-python3 libtool libtinfo5 bison
+RUN set -x \
+    && printf "deb http://archive.debian.org/debian bullseye main\ndeb http://archive.debian.org/debian-security bullseye-security main\n" > /etc/apt/sources.list \
+    && apt-get update && apt-get install -y unzip automake build-essential curl file pkg-config git python3 python-is-python3 libtool libtinfo5 bison
 
 WORKDIR /opt/android
 ## INSTALL ANDROID SDK
@@ -83,7 +85,7 @@ RUN set -x \
 ENV ZLIB_VERSION=1.3.1
 ENV ZLIB_HASH=9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23
 RUN set -x \
-    && curl -O https://zlib.net/zlib-${ZLIB_VERSION}.tar.gz \
+    && curl -LO https://github.com/madler/zlib/releases/download/v${ZLIB_VERSION}/zlib-${ZLIB_VERSION}.tar.gz \
     && echo "${ZLIB_HASH}  zlib-${ZLIB_VERSION}.tar.gz" | sha256sum -c \
     && tar -xzf zlib-${ZLIB_VERSION}.tar.gz \
     && rm zlib-${ZLIB_VERSION}.tar.gz \
@@ -127,10 +129,11 @@ RUN set -x \
 ARG SODIUM_VERSION=1.0.18
 ARG SODIUM_HASH=4f5e89fa84ce1d178a6765b8b46f2b6f91216677
 RUN set -x \
-    && git clone https://github.com/jedisct1/libsodium.git -b ${SODIUM_VERSION} \
+    && git clone https://github.com/jedisct1/libsodium.git \
     && cd libsodium \
+    && git checkout -q ${SODIUM_HASH} \
     && test `git rev-parse HEAD` = ${SODIUM_HASH} || exit 1 \
-    && ./autogen.sh \
+    && DO_NOT_UPDATE_CONFIG_SCRIPTS=1 ./autogen.sh \
     && CC=clang CXX=clang++ ./configure --prefix=${PREFIX} --host=arm-linux-androideabi --enable-static --disable-shared \
     && make  -j${NPROC} \
     && make install
